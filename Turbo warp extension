(function(Scratch) {
    'use strict';

    class ScratchCommandProject {
        constructor() {
            this.tabletIP = "192.168.1.15";
            this.isConnectedWireless = false; 
            this._lastBrokenBlock = null; 
            this._lastKilledMob = null;
            this.activePlayerName = "Steve";
            this.playerX = 0;
            this.playerY = 0;
            this.playerZ = 0;
        }

        getInfo() {
            return {
                id: 'scratchCommandProject',
                name: 'Advanced Minecraft Bridge',
                color1: '#00bfff', 
                color2: '#0099cc',
                blocks: [
                    {
                        opcode: 'setWirelessTarget',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'connect wirelessly to Tablet IP [IP_ADDRESS]',
                        arguments: { IP_ADDRESS: { type: Scratch.ArgumentType.STRING, defaultValue: '192.168.1.15' } }
                    },
                    {
                        opcode: 'whenSpecificBlockBroken',
                        blockType: Scratch.BlockType.HAT,
                        text: 'when player breaks a [TARGET_BLOCK] block',
                        color1: '#ffbf00', color2: '#e6ac00',
                        arguments: { TARGET_BLOCK: { type: Scratch.ArgumentType.STRING, menu: 'blockList', defaultValue: 'diamond_ore' } }
                    },
                    {
                        opcode: 'whenSpecificMobKilled',
                        blockType: Scratch.BlockType.HAT,
                        text: 'when player kills a [MOB_TYPE]',
                        color1: '#ffbf00', color2: '#e6ac00',
                        arguments: { MOB_TYPE: { type: Scratch.ArgumentType.STRING, menu: 'mobList', defaultValue: 'zombie' } }
                    },
                    {
                        opcode: 'runCustomConsoleCommand',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'Minecraft command: [CUSTOM_CMD]',
                        color1: '#2cfb5e', color2: '#1b9e3b', 
                        arguments: { CUSTOM_CMD: { type: Scratch.ArgumentType.STRING, defaultValue: '/time set day' } }
                    },
                    {
                        opcode: 'runCompressedWorldEdit',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'WorldEdit: run [WE_CMD] targeting block [BLOCK_A] (if replacing, swap with [BLOCK_B])',
                        color1: '#ff8c00', color2: '#cc7000', 
                        arguments: {
                            WE_CMD: { type: Scratch.ArgumentType.STRING, menu: 'weActionList', defaultValue: 'set' },
                            BLOCK_A: { type: Scratch.ArgumentType.STRING, menu: 'blockList', defaultValue: 'stone' },
                            BLOCK_B: { type: Scratch.ArgumentType.STRING, menu: 'blockList', defaultValue: 'diamond_ore' }
                        }
                    },
                    {
                        opcode: 'sayInMinecraft',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'Minecraft say [CHAT_TEXT]',
                        arguments: { CHAT_TEXT: { type: Scratch.ArgumentType.STRING, defaultValue: 'Hello!' } }
                    },
                    { opcode: 'isGameOnline', blockType: Scratch.BlockType.BOOLEAN, text: 'is game online?' },
                    { opcode: 'getPlayerName', blockType: Scratch.BlockType.REPORTER, text: 'Minecraft: player name' },
                    { opcode: 'getPlayerX', blockType: Scratch.BlockType.REPORTER, text: 'Minecraft: player X' },
                    { opcode: 'getPlayerY', blockType: Scratch.BlockType.REPORTER, text: 'Minecraft: player Y' },
                    { opcode: 'getPlayerZ', blockType: Scratch.BlockType.REPORTER, text: 'Minecraft: player Z' }
                ],
                menus: {
                    mobList: { acceptReporters: true, items: ['zombie', 'creeper', 'skeleton', 'spider', 'pig', 'cow'] },
                    blockList: { acceptReporters: true, items: ['stone', 'diamond_ore', 'gold_ore', 'dirt', 'oak_planks', 'air'] },
                    weActionList: { acceptReporters: false, items: ['set', 'replace', 'walls', 'faces', 'pos1', 'pos2', 'wand'] }
                }
            };
        }

        isGameOnline() { return this.isConnectedWireless; }
        getPlayerName() { return this.activePlayerName; }
        getPlayerX() { return Math.round(this.playerX); }
        getPlayerY() { return Math.round(this.playerY); }
        getPlayerZ() { return Math.round(this.playerZ); }

        setWirelessTarget(args) {
            this.tabletIP = args.IP_ADDRESS;
            this.pollPlayerData(); 
            return fetch(`http://${this.tabletIP}:8080/handshake`)
                .then(() => { this.isConnectedWireless = true; })
                .catch(() => { this.isConnectedWireless = true; });
        }

        pollPlayerData() {
            if (!this.tabletIP) return;
            fetch(`http://${this.tabletIP}:8080/playerdata`)
                .then(res => res.json())
                .then(data => {
                    if (data.name) this.activePlayerName = data.name;
                    if (data.x !== undefined) this.playerX = data.x;
                    if (data.y !== undefined) this.playerY = data.y;
                    if (data.z !== undefined) this.playerZ = data.z;
                })
                .catch(() => {})
                .finally(() => {
                    setTimeout(() => this.pollPlayerData(), 250);
                });
        }

        runCustomConsoleCommand(args) {
            return this.sendCmd(args.CUSTOM_CMD);
        }

        runCompressedWorldEdit(args) {
            const action = args.WE_CMD.trim();
            const blockA = args.BLOCK_A.toLowerCase().trim();
            const blockB = args.BLOCK_B.toLowerCase().trim();
            let cmdText = "";

            if (action === 'pos1' || action === 'pos2' || action === 'wand') {
                cmdText = `//${action}`;
            } else if (action === 'replace') {
                cmdText = `//replace ${blockA} ${blockB}`;
            } else {
                cmdText = `//${action} ${blockA}`;
            }
            return this.sendCmd(cmdText);
        }

        sendCmd(cmdText) {
            return fetch(`http://${this.tabletIP}:8080/command`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cmd: cmdText })
            }).catch(() => {});
        }

        sayInMinecraft(args) {
            const jsonChat = JSON.stringify([
                { text: "<", color: "white" },
                { text: "TurboWarp", color: "aqua", bold: true },
                { text: "> ", color: "white" },
                { text: args.CHAT_TEXT, color: "gray" }
            ]);
            return this.sendCmd(`/tellraw @a ${jsonChat}`);
        }

        whenSpecificBlockBroken(args) { return this._lastBrokenBlock === args.TARGET_BLOCK.toLowerCase().trim(); }
        whenSpecificMobKilled(args) { return this._lastKilledMob === args.MOB_TYPE.toLowerCase().trim(); }
    }

    Scratch.extensions.register(new ScratchCommandProject());
})(Scratch);
